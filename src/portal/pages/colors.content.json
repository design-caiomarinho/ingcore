    "76:1565": "INTRODUÇÃO",
    "I76:1566;27:72": "Primeiros passos",
    "76:1568": "FUNDAMENTOS",
    "I76:1570;31:117": "Cores",
    "I76:1571;27:72": "Tipografia",
