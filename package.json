{
  "name": "ingcore-storybook-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-tokens.mjs && node scripts/validate-portal.mjs && tsc --noEmit && vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "check": "tsc --noEmit",
    "tokens": "node scripts/generate-tokens.mjs",
    "check:tokens": "node scripts/generate-tokens.mjs --check",
    "check:portal": "node scripts/validate-portal.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass": "^1.105.2",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
